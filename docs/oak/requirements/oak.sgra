[GRAMMAR]
ELEMENTS:
- TAG: COMPONENT
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
  - TITLE: STATUS
    TYPE: SingleChoice(Proposed, Specified, Implemented, PassedSubstitute, PassedDocumentation, Recorded)
    REQUIRED: True
  - TITLE: OWNER
    TYPE: String
    REQUIRED: True
  - TITLE: SOURCE
    TYPE: String
    REQUIRED: True
  - TITLE: SCOPE
    TYPE: SingleChoice(Production, EngineeringHarness, Documentation)
    REQUIRED: True
  - TITLE: VERIFICATION
    TYPE: SingleChoice(NotRun, PartialSubstitute, PassedSubstitute, PassedDocumentation, NotApplicable)
    REQUIRED: True
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
  - TITLE: RATIONALE
    TYPE: String
    REQUIRED: False
  RELATIONS:
  - TYPE: Parent
    ROLE: OwnedBy
    REVERSE_ROLE: Owns
