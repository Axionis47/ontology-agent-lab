OAK_ENVIRONMENT=production
OAK_DATABASE_URL=postgresql://postgres:password@your-supabase-host:5432/postgres?sslmode=require
OAK_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
OAK_PUBLIC_API_URL=https://your-oak-api.onrender.com
OAK_FRONTEND_URL=https://your-oak-web.vercel.app
OAK_SECRET_BACKEND=vault
OAK_ALLOW_LOCAL_MCP=false
OAK_GEMINI_PROJECT=
OAK_GEMINI_LOCATION=global
OAK_GEMINI_MODEL=gemini-3.8-flash
OAK_GEMINI_TIMEOUT=25
OAK_GEMINI_MAX_OUTPUT_TOKENS=4096
OAK_GEMINI_CHECK_BUDGET_USD=0
OAK_SURFACE_MAX_COST_USD=10
OAK_SURFACE_MAX_MCP_CALLS=100
OAK_SURFACE_MAX_MODEL_CALLS=100
OAK_SURFACE_MAX_ACTIVE_SECONDS=3600
OAK_SURFACE_MAX_CLARIFICATION_ROUNDS=10
OAK_SURFACE_INPUT_TOKENS=32768
OAK_SURFACE_PROBE_OUTPUT_TOKENS=4096
OAK_SURFACE_PROPOSAL_OUTPUT_TOKENS=16384
OAK_SURFACE_MODEL_TIMEOUT=90
OAK_SURFACE_TOOL_TIMEOUT=30
