# Copy to .env and supply a strong local password. Never commit .env.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Hosted tracing remains off until a key and intended project are configured.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ontology-agent-lab-oak
LANGSMITH_API_KEY=

# Set to your JDK root when Java is not on PATH.
JAVA_HOME=
