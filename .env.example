# Copy to .env and source explicitly. Viewing published evidence needs none of these.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
OWB_MODEL=gemini-2.5-flash
# Enable only for explicitly requested new live work:
OWB_ENABLE_LIVE=0
# Optional absolute paths, otherwise repo-local defaults in core.py are used:
# APPWORLD_SOURCE_DIR=/path/to/appworld
# APPWORLD_DATA_DIR=/path/to/downloaded/data
# APPWORLD_RUN_DIR=/path/to/isolated/run-root
# OWB_RECORDS_DIR=/path/to/isolated/private-records
